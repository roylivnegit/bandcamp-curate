# ─────────────────────────────────────────────────────────────
# crate-digger config. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Nimble v2 API — Bearer token. Get it from the Nimble dashboard.
# Sent as:  Authorization: Bearer ${NIMBLE_API_KEY}
NIMBLE_API_KEY=

# Nimble endpoint + defaults (override only if needed)
NIMBLE_BASE_URL=https://sdk.nimbleway.com/v2
NIMBLE_COUNTRY=US
NIMBLE_DRIVER=auto

# Database (Postgres). Local compose host is `postgres`; for a managed provider
# (Neon/Supabase/…) paste its connection URL as-is — app/db/url.py forces the
# +asyncpg driver and translates sslmode/channel_binding automatically. Use the
# DIRECT (non-pooled) endpoint (pooled = PgBouncer, breaks asyncpg prepared stmts).
# QUOTE the value if it contains `&`/`?` (e.g. ?sslmode=require&channel_binding=…)
# so `set -a && . .env` doesn't choke on the `&`.
DATABASE_URL=postgresql+asyncpg://crate:crate@postgres:5432/crate

# Redis (ARQ queue + rate limiter + cache). Inside compose the host is `redis`.
REDIS_URL=redis://redis:6379/0

# Scraper rate limiting — stay well under Nimble's 83 QPS ceiling.
SCRAPER_MAX_QPS=2
SCRAPER_MAX_CONCURRENCY=4

# Your Bandcamp fan page (seed). e.g. https://bandcamp.com/yourusername
# Legacy/operator-only: every signed-up user now carries their own fan url on
# the `users` row (set at signup). Only `scripts/crawl.py` still reads this.
BANDCAMP_FAN_URL=

# Off by default. The legacy operator crawl chain above (`scripts/crawl.py
# seed`/`run`, and the `seed_crawl` ARQ job) refuses to run unless this is
# true — set it only if you deliberately still use that single-tenant path.
ENABLE_OPERATOR_CRAWL=false

# Auth — JWT signing key. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be non-empty (PyJWT rejects an empty HMAC key) and >=32 bytes.
AUTH_SECRET_KEY=

# Shared code required at signup. Every scan a new user queues runs on YOUR
# machine against YOUR Nimble credits, so keep this private. Empty = signup off.
AUTH_INVITE_CODE=

# The React app's origin, for CORS (the frontend is a separate service).
FRONTEND_ORIGIN=http://localhost:5173

# App
APP_ENV=local
LOG_LEVEL=INFO
