# ─────────────────────────────────────────────────────────────
# crate-digger config. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Nimble v2 API — Bearer token. Get it from the Nimble dashboard.
# Sent as:  Authorization: Bearer ${NIMBLE_API_KEY}
NIMBLE_API_KEY=

# Nimble endpoint + defaults (override only if needed)
NIMBLE_BASE_URL=https://sdk.nimbleway.com/v2
NIMBLE_COUNTRY=US
NIMBLE_DRIVER=auto

# Database (Postgres). Inside docker-compose the host is `postgres`.
DATABASE_URL=postgresql+asyncpg://crate:crate@postgres:5432/crate

# Redis (ARQ queue + rate limiter + cache). Inside compose the host is `redis`.
REDIS_URL=redis://redis:6379/0

# Scraper rate limiting — stay well under Nimble's 83 QPS ceiling.
SCRAPER_MAX_QPS=2
SCRAPER_MAX_CONCURRENCY=4

# Your Bandcamp fan page (seed). e.g. https://bandcamp.com/yourusername
BANDCAMP_FAN_URL=

# App
APP_ENV=local
LOG_LEVEL=INFO
